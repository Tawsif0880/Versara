# Optional. Without this key, public YouTube oEmbed metadata is used.
YOUTUBE_API_KEY=
# Required for AI song identification and English translation via Groq.
GROQ_API_KEY=
# Optional legacy alias. GROQ_API_KEY takes precedence when both are set.
TRANSLATION_API_KEY=
TRANSLATION_BASE_URL=https://api.groq.com/openai/v1
TRANSLATION_MODEL=qwen/qwen3.8-27b
# Optional identifier for LRCLIB requests (public contact/project URL).
LRCLIB_USER_AGENT=Versara/1.0 (personal lyrics PWA)
